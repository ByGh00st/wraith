#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        # If an active session is in progress, attempt graceful stop
        if [ -x /usr/bin/wraith ] && { [ -f /var/run/wraith.state ] || [ -f /run/wraith.state ]; }; then
            /usr/bin/wraith stop 2>/dev/null || true
        fi
        ;;
    upgrade|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
